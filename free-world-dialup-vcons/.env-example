# ── Free World Dialup / Phound SIP credentials ──────────────────────────────
# Found in your portal under "SIP Connection → Generic SIP"
SIP_SERVER=ow-sbc.phound.app:7070
SIP_LOGIN=
SIP_PASSWORD=

# ── Outbound call target ─────────────────────────────────────────────────────
# E.164 format, e.g. +15551234567
DIAL_TARGET=+15551234567

# How long (seconds) to keep the call up — long enough for voicemail + recording
CALL_DURATION_SECONDS=30

# ── Webhook authentication ───────────────────────────────────────────────────
# Must match the shared secret you configured in the Phound webhook settings
WEBHOOK_SECRET=

# ── UI API key ───────────────────────────────────────────────────────────────
# Leave blank to auto-generate at startup (key is printed in container logs).
# Set explicitly to pin a stable key across restarts.
UI_API_KEY=

# ── ngrok ────────────────────────────────────────────────────────────────────
NGROK_AUTHTOKEN=
# Reserved/branded domain on your ngrok account
NGROK_URL=ngrok.relayhawk.io

# ── Optional tuning ──────────────────────────────────────────────────────────
# LOG_LEVEL=debug
