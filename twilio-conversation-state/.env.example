# --- Public URL -------------------------------------------------------------
# Your ngrok (or other) domain, without https://. Twilio calls /twiml and opens
# wss://<this>/ws, and webhook signatures are checked against it.
PUBLIC_URL=your-subdomain.ngrok.app
NGROK_AUTHTOKEN=your_ngrok_token_here

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# --- Twilio -------------------------------------------------------------------
# Needed for webhook signature checks, call recording, and outbound calls.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567

# --- Agent --------------------------------------------------------------------
COMPANY_NAME=Relay Hawk
TTS_PROVIDER=ElevenLabs
TTS_VOICE=ZF6FPAbjXT4488VcRRnw-flash_v2_5-1.2_1.0_1.0
ENABLE_RECORDING=true
# Region for phone numbers said without a country code.
DEFAULT_PHONE_REGION=US

# --- Dashboard ----------------------------------------------------------------
# Strongly recommended: the dashboard shows caller PII on a public URL.
# Setting it also enables the "Call me" button (outbound calls cost money).
DASHBOARD_PASSWORD=

# --- Storage ------------------------------------------------------------------
DATABASE_PATH=data/calls.db
RECORDINGS_DIR=data/recordings
